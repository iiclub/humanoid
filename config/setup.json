  "drive": {
    "node": "drive",
    "type": "differential",
    "maxPwm": 1023,
    "defaultSpeed": 900,
    "turnScale": 1,
    "failsafeMs": 600,
    "motors": {
      "leftFront": {
        "rpwm": "D0",
        "lpwm": "D1",
        "invert": false
      },
      "leftRear": {
        "rpwm": "D2",
        "lpwm": "D3",
        "invert": false
      },
      "rightFront": {
        "rpwm": "D4",
        "lpwm": "D5",
        "invert": false
      },
      "rightRear": {
        "rpwm": "D6",
        "lpwm": "D7",
        "invert": false
      }
    }
  },
  "_motor_fields": {
    "driver": "L298N, direction pins only — HIGH/LOW, no PWM, so there is no speed control",
    "node": "which NodeMCU drives it — its firmware must define the same pins",
    "pinUp": "L298N IN1: HIGH raises the torso (IN2 low). The 'up' button.",
    "pinDown": "L298N IN2: HIGH lowers it (IN1 low). The 'down' button.",
    "pinEn": "L298N ENA: the bridge enable. HIGH only while the motor is meant to turn.",
    "invert": "true swaps up and down without rewiring",
    "failsafeMs": "firmware stops the motor if no command arrives inside this window",
    "maxRunMs": "hard cap on one continuous run in one direction, held button or not — there are no limit switches, so this is what protects the mechanism",
    "autoLowerOnRelease": "letting go of the 'up' button drives back down on its own, for up to maxRunMs"
  },
  "motor": {
    "id": "torso_lift",
    "label": "Torso Lift (Right Hand)",
    "node": "right_hand",
    "driver": "l298n",
    "pinUp": "D3",
    "pinDown": "D4",
    "pinEn": "D0",
    "invert": false,
    "failsafeMs": 4000,
    "maxRunMs": 4000,
    "autoLowerOnRelease": true
  },
  "_light_fields": {
    "node": "which NodeMCU drives it — its firmware must define the same pin",
    "pin": "driven with PWM so the ramps are real fades; on D8/GPIO15 nothing may pull the pin high at boot",
    "pwm": "false for a relay: the ramps collapse to plain on/off. Must match LIGHT_PWM in the firmware.",
    "startOn": "the firmware runs its power-on sequence regardless; this is what the server assumes the light is doing afterwards",
    "bootBlinks": "blinks on power-up before the slow ramp (firmware constant, repeated here so the UI can describe it)",
    "bootFadeMs": "how long the power-on ramp to full takes",
    "fadeMs": "ramp used by the on/off buttons"
  },
  "light": {
    "id": "work_light",
    "label": "Light (Left Hand)",
    "node": "left_hand",
    "pin": "D3",
    "pwm": false,
    "startOn": true,
    "bootBlinks": 3,
    "bootFadeMs": 2500,
    "fadeMs": 600
  },
