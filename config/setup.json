    "backendUdpPort": 4211,
    "broadcastAddress": "255.255.255.255",
    "announceIntervalMs": 3000,
    "heartbeatTimeoutMs": 6000,
    "commandRateHz": 25
  },
  "nodes": {
    "right_hand": {
      "id": "right_hand",
      "label": "Right Hand NodeMCU",
      "apSsid": "HUMANOID-RIGHT",
      "apPassword": "12345678",
      "servoCount": 5,
      "ip": null
    },
    "left_hand": {
      "id": "left_hand",
      "label": "Left Hand + Head NodeMCU",
      "apSsid": "HUMANOID-LEFT",
      "apPassword": "12345678",
      "servoCount": 6,
      "ip": null
