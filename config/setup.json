      "servoCount": 0,
      "ip": null
    }
  },
  "_joint_fields": {
    "node": "which NodeMCU owns this servo",
    "channel": "servo index inside that NodeMCU firmware (must match the firmware pin table order)",
    "pin": "NodeMCU pin label, documentation + firmware cross-check",
    "min/max": "mechanical limits in servo degrees",
    "initial": "HOME angle. Must be min or max (0 or 180). Motion always starts here and travels to the other end.",
    "direction": "+1 = servo turns the natural way, -1 = mirrored/reversed horn (angle is flipped before it is sent)",
    "trim": "degrees added after direction is applied, to correct horn spline offset",
    "speed": "max degrees per second used by the firmware slew limiter",
    "vizRange": "[deg at travel 0, deg at travel 100] used only by the 3D / stick figure viewer"
  },
  "joints": [
    {
      "id": "right_shoulder_x",
      "label": "R Shoulder X (front/back)",
