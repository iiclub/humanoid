    {
      "id": "left_wrist_z",
      "label": "L Wrist Roll (Z)",
      "group": "left_arm",
      "node": "left_hand",
      "channel": 3,
      "pin": "D7",
      "min": 0,
      "max": 180,
      "initial": 180,
      "direction": -1,
