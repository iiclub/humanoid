  "drive": {
    "node": "drive",
    "type": "differential",
    "maxPwm": 1023,
    "defaultSpeed": 900,
    "turnScale": 1,
    "failsafeMs": 600,
    "motors": {
      "leftFront": {
        "rpwm": "D0",
        "lpwm": "D1",
        "invert": false
      },
      "leftRear": {
        "rpwm": "D2",
        "lpwm": "D3",
        "invert": false
      },
      "rightFront": {
        "rpwm": "D4",
        "lpwm": "D5",
        "invert": false
      },
      "rightRear": {
        "rpwm": "D6",
        "lpwm": "D7",
        "invert": false
      }
    }
  },
  "_motor_fields": {
    "driver": "L298N, direction pins only — HIGH/LOW, no PWM, so there is no speed control",
    "node": "which NodeMCU drives it — its firmware must define the same two pins",
    "pinCw": "L298N IN1: HIGH turns clockwise (IN2 low). The 'up' button.",
    "pinCcw": "L298N IN2: HIGH turns anticlockwise (IN1 low). The 'down' button.",
    "invert": "true swaps clockwise and anticlockwise without rewiring",
    "failsafeMs": "firmware stops the motor if no command arrives inside this window"
  },
  "motor": {
    "id": "aux_motor",
    "label": "Aux Motor (Right Hand)",
    "node": "right_hand",
    "driver": "l298n",
    "pinCw": "D7",
    "pinCcw": "D8",
    "invert": false,
    "failsafeMs": 600
  },
